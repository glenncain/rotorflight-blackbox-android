# Copy this file to "local.properties" and set sdk.dir to your Android SDK.
#
# Windows example (note forward slashes or escaped backslashes):
#   sdk.dir=C:/Users/<you>/AppData/Local/Android/Sdk
#
# macOS example:
#   sdk.dir=/Users/<you>/Library/Android/sdk
#
# Linux example:
#   sdk.dir=/home/<you>/Android/Sdk
#
# Alternatively, set the ANDROID_HOME environment variable and omit this file.
sdk.dir=C:/Users/<you>/AppData/Local/Android/Sdk
